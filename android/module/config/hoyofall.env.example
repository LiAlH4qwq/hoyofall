# Subscription tokens for hoyofall on Android.
#
# The module seeds this file to
# /data/adb/hoyofall/hoyofall/hoyofall.env on first boot. config.yaml
# references HOYOFALL_SUB_URL with `urlEnv`; the value never touches
# config.yaml or git. One KEY=value per line; `#` starts a comment.
#
# The placeholder points at a closed local port so the daemon starts without a
# token (it logs one failed refresh and writes an empty fragment). Replace it
# with your subscription URL.
HOYOFALL_SUB_URL=http://127.0.0.1:9/disabled
