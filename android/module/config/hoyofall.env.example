# Subscription tokens for hoyofall on Android.
#
# The module seeds this file to /data/adb/hoyofall/hoyofall.env on first boot.
# config.yaml references these variables with `urlEnv`; the values never touch
# config.yaml or git. One KEY=value per line; `#` starts a comment.
#
# HOYOFALL_SUB_URL=https://example.com/subscribe?token=REPLACE_ME
