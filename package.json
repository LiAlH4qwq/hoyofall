{
  "name": "hoyofall",
  "version": "0.8.0",
  "private": true,
  "type": "module",
  "description": "Provably type-safe converter from mihomo (Clash.Meta) subscriptions to sing-box outbound fragments",
  "keywords": [
    "mihomo",
    "clash-meta",
    "sing-box",
    "subscription",
    "converter",
    "proxy",
    "type-safe",
    "effect",
    "typescript",
    "nix"
  ],
  "bin": {
    "hoyofall": "./dist/index.js"
  },
  "scripts": {
    "build": "rolldown -c rolldown.config.ts && node dist/index.js --print-schema > dist/schema.json && pnpm run build:webui && pnpm run build:supervisor",
    "build:webui": "rolldown -c android/webui/rolldown.config.ts",
    "build:supervisor": "rolldown -c android/supervisor/rolldown.config.ts",
    "gen:schema": "tsx scripts/gen-schema.ts",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "typecheck:webui": "tsc --noEmit -p android/webui/tsconfig.json",
    "typecheck:supervisor": "tsc --noEmit -p android/supervisor/tsconfig.json",
    "check:ast": "tsx scripts/check-ast.ts",
    "lint": "eslint . && tsx scripts/check-ast.ts && tsx scripts/check-shell.ts",
    "check": "tsc --noEmit && tsc --noEmit -p android/webui/tsconfig.json && tsc --noEmit -p android/supervisor/tsconfig.json && eslint . && tsx scripts/check-ast.ts && tsx scripts/check-shell.ts && vitest run",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@effect/platform": "^0.97.2",
    "@effect/platform-node": "^0.108.2",
    "effect": "^3.22.2",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@effect/vitest": "^0.30.0",
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.0.0",
    "eslint": "^9.39.1",
    "eslint-plugin-functional": "^10.0.1",
    "rolldown": "^1.2.10",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.1",
    "vitest": "^4.0.0"
  },
  "engines": {
    "node": ">=26"
  }
}
