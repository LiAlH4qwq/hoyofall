# Environment file for hoyofall, referenced by the unit as
# EnvironmentFile=-/etc/hoyofall/hoyofall.env.
#
# Each variable is named after the `urlEnv` of a subscription in config.yaml,
# so subscription tokens never live in the configuration file. Keep this file
# out of version control and readable only by root (0640 root:root is fine:
# the service receives the values through systemd, not by reading the file).

AIRPORT_URL=https://example.com/subscribe?token=REPLACE_ME
